<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ImageStudio.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Vertex AI Studio">

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Padding="4,0,140,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button x:Name="GearButton" Style="{StaticResource IconButton}" Click="Gear_Click"
                        ToolTipService.ToolTip="설정" AutomationProperties.Name="설정">
                    <FontIcon Glyph="&#xE713;" FontSize="15" />
                </Button>
                <Image Source="ms-appx:///Assets/app.ico" Width="16" Height="16" />
                <TextBlock Text="Vertex AI Studio" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Text="Image" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <StackPanel x:Name="ProxyStatus" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,6,0">
                    <Ellipse x:Name="ProxyDot" Width="8" Height="8" Fill="Gray" />
                    <TextBlock x:Name="ProxyText" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="프록시 확인 중…" />
                </StackPanel>
                <Button x:Name="PanelToggleButton" Style="{StaticResource IconButton}" Click="TogglePanel_Click"
                        ToolTipService.ToolTip="이미지 설정 패널 접기/펼치기">
                    <FontIcon Glyph="&#xE700;" FontSize="14" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Main -->
        <Grid x:Name="MainArea" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SideColumn" Width="240" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="SetColumn" Width="320" />
            </Grid.ColumnDefinitions>

            <!-- Left: conversations -->
            <Border Grid.Column="0" Background="{ThemeResource PaneBrush}" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,1,0">
                <Grid>
                    <Grid x:Name="SideExpanded" Padding="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" Click="NewConversation_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE710;" FontSize="12" />
                                    <TextBlock Text="새 대화" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="1" Style="{StaticResource IconButton}" Click="ToggleSide_Click" ToolTipService.ToolTip="대화 목록 접기">
                                <FontIcon Glyph="&#xE76B;" FontSize="12" />
                            </Button>
                        </Grid>
                        <AutoSuggestBox x:Name="SearchBox" Grid.Row="1" Margin="0,10,0,6" PlaceholderText="대화 검색" QueryIcon="Find"
                                        TextChanged="Search_TextChanged" />
                        <ListView x:Name="ConversationList" Grid.Row="2" SelectionMode="Single" Padding="0"
                                  SelectionChanged="ConversationList_SelectionChanged" IsItemClickEnabled="False" />
                        <Button x:Name="TrashButton" Grid.Row="3" Style="{StaticResource IconButton}" Width="Auto" HorizontalAlignment="Left" Padding="8,0" Click="Trash_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE74D;" FontSize="12" />
                                <TextBlock x:Name="TrashText" Text="휴지통" Style="{StaticResource CaptionTextBlockStyle}" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <StackPanel x:Name="SideRail" Visibility="Collapsed" Spacing="8" Padding="0,10,0,0" HorizontalAlignment="Center">
                        <Button Style="{StaticResource IconButton}" Click="ToggleSide_Click" ToolTipService.ToolTip="대화 목록 펼치기">
                            <FontIcon Glyph="&#xE76C;" FontSize="12" />
                        </Button>
                        <Button Style="{StaticResource IconButton}" Click="NewConversation_Click" ToolTipService.ToolTip="새 대화">
                            <FontIcon Glyph="&#xE710;" FontSize="13" Foreground="{ThemeResource AccentText}" />
                        </Button>
                        <Button Style="{StaticResource IconButton}" Click="RailSearch_Click" ToolTipService.ToolTip="검색">
                            <FontIcon Glyph="&#xE721;" FontSize="13" />
                        </Button>
                        <TextBlock Text="대화 목록" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   HorizontalAlignment="Center" Margin="0,8,0,0">
                            <TextBlock.RenderTransform><RotateTransform Angle="90" CenterX="24" CenterY="8" /></TextBlock.RenderTransform>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Center: chat -->
            <Grid Grid.Column="1" x:Name="ChatArea" AllowDrop="True" DragOver="Chat_DragOver" Drop="Chat_Drop">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,1" Padding="16,8">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ScrollViewer HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Hidden" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="ChipsPanel" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" />
                        </ScrollViewer>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <TextBlock x:Name="ContextText" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                            <ProgressBar x:Name="ContextBar" Width="110" Maximum="100" Value="0" VerticalAlignment="Center" />
                            <Button x:Name="CompactButton" Click="Compact_Click" ToolTipService.ToolTip="대화 내용을 요약해 컨텍스트를 줄입니다 (/compact)">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE73F;" FontSize="12" />
                                    <TextBlock Text="압축 (/compact)" Style="{StaticResource CaptionTextBlockStyle}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <InfoBar x:Name="Banner" Grid.Row="1" IsOpen="False" IsClosable="True" Margin="16,8,16,0" />

                <ScrollViewer x:Name="MessagesScroll" Grid.Row="2" Padding="28,16,28,16"
                              HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" SizeChanged="MessagesScroll_SizeChanged"
                              VerticalScrollMode="Enabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="MessagesPanel" Spacing="18" MaxWidth="1100" HorizontalAlignment="Left" />
                </ScrollViewer>
                <StackPanel x:Name="EmptyState" Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
                    <FontIcon Glyph="&#xEB9F;" FontSize="36" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock Text="만들고 싶은 이미지를 설명해 보세요" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
                    <TextBlock Text="결과를 보고 &quot;더 밝게&quot;, &quot;배경만 바꿔줘&quot;처럼 이어서 수정할 수 있습니다." Style="{StaticResource SubText}" HorizontalAlignment="Center" />
                </StackPanel>

                <Border Grid.Row="3" Background="{ThemeResource PaneBrush}" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="16,12">
                    <StackPanel Spacing="8">
                        <StackPanel x:Name="ContinueBar" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
                            <FontIcon Glyph="&#xE72A;" FontSize="12" Foreground="{ThemeResource AccentText}" />
                            <Image x:Name="ContinueThumb" Width="28" Height="28" Stretch="UniformToFill" />
                            <TextBlock Text="이 이미지로 계속" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
                            <HyperlinkButton Content="해제" Padding="4,0" Click="ClearContinue_Click" />
                        </StackPanel>
                        <StackPanel x:Name="AttachPanel" Orientation="Horizontal" Spacing="8" Visibility="Collapsed" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="AttachButton" Width="64" Height="64" Padding="0" VerticalAlignment="Bottom" CornerRadius="8"
                                    Click="Attach_Click" ToolTipService.ToolTip="참조 이미지 첨부 (드래그&amp;드롭 / Ctrl+V)">
                                <FontIcon Glyph="&#xEB9F;" FontSize="24" />
                            </Button>
                            <TextBox x:Name="PromptBox" Grid.Column="1" MinHeight="64" MaxHeight="220" AcceptsReturn="True" TextWrapping="Wrap"
                                     VerticalContentAlignment="Center" Padding="12,10"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     PlaceholderText="프롬프트 입력 · /compact 로 대화 압축 · 이미지 드래그&amp;드롭 / Ctrl+V"
                                     PreviewKeyDown="PromptBox_PreviewKeyDown" Paste="PromptBox_Paste" />
                            <Border x:Name="BusyOverlay" Grid.Column="1" Visibility="Collapsed" CornerRadius="6" Padding="12,0"
                                    Background="{ThemeResource SmokeFillColorDefaultBrush}">
                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <ProgressRing IsActive="True" Width="18" Height="18" />
                                    <TextBlock x:Name="BusyText" VerticalAlignment="Center" />
                                    <Button Content="■ 취소" Click="Cancel_Click" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <ToggleSwitch x:Name="QuickEnhance" OnContent="프롬프트 인핸스" OffContent="프롬프트 인핸스" MinWidth="0" Toggled="QuickToggle_Toggled" />
                                <ToggleSwitch x:Name="QuickSearch" OnContent="Google 검색 그라운딩" OffContent="Google 검색 그라운딩" MinWidth="0" Toggled="QuickToggle_Toggled" />
                            </StackPanel>
                            <TextBlock x:Name="KeyHint" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Right: image settings -->
            <Border Grid.Column="2" Background="{ThemeResource PaneBrush}" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1,1,0,0">
                <Grid>
                    <ScrollViewer x:Name="SetExpanded" Padding="14,10,14,16">
                        <StackPanel x:Name="SetPanel">
                            <Grid>
                                <TextBlock Text="이미지 설정" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                                <Button HorizontalAlignment="Right" Style="{StaticResource IconButton}" Click="TogglePanel_Click" ToolTipService.ToolTip="설정 패널 접기">
                                    <FontIcon Glyph="&#xE76C;" FontSize="12" />
                                </Button>
                            </Grid>
                            <!-- rows are built in code (MainWindow.Settings.cs) -->
                        </StackPanel>
                    </ScrollViewer>
                    <StackPanel x:Name="SetRail" Visibility="Collapsed" Spacing="8" Padding="0,10,0,0" HorizontalAlignment="Center">
                        <Button Style="{StaticResource IconButton}" Click="TogglePanel_Click" ToolTipService.ToolTip="설정 패널 펼치기">
                            <FontIcon Glyph="&#xE76B;" FontSize="12" />
                        </Button>
                        <FontIcon Glyph="&#xE713;" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- App settings page (gear) -->
            <Grid x:Name="SettingsPage" Grid.ColumnSpan="3" Visibility="Collapsed" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
                <ScrollViewer Padding="24,12,24,24">
                    <StackPanel x:Name="SettingsPagePanel" MaxWidth="760" Spacing="8" HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Style="{StaticResource IconButton}" Click="Back_Click" ToolTipService.ToolTip="뒤로">
                                <FontIcon Glyph="&#xE72B;" FontSize="14" />
                            </Button>
                            <TextBlock Text="설정" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Image preview overlay -->
            <Grid x:Name="PreviewOverlay" Grid.ColumnSpan="3" Visibility="Collapsed" Background="#E6000000" Tapped="PreviewBackground_Tapped">
                <ScrollViewer x:Name="PreviewScroll" ZoomMode="Enabled" MinZoomFactor="0.1" MaxZoomFactor="10"
                              HorizontalScrollMode="Enabled" VerticalScrollMode="Enabled"
                              HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"
                              Margin="60,40" DoubleTapped="PreviewScroll_DoubleTapped">
                    <Image x:Name="PreviewImage" Stretch="Fill" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Tapped="PreviewImage_Tapped" ImageOpened="PreviewImage_ImageOpened" />
                </ScrollViewer>
                <Button HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12" Click="PreviewPrev_Click" Style="{StaticResource IconButton}" Width="40" Height="60">
                    <FontIcon Glyph="&#xE76B;" Foreground="White" />
                </Button>
                <Button HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12" Click="PreviewNext_Click" Style="{StaticResource IconButton}" Width="40" Height="60">
                    <FontIcon Glyph="&#xE76C;" Foreground="White" />
                </Button>
                <Button HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12" Click="PreviewClose_Click" Style="{StaticResource IconButton}">
                    <FontIcon Glyph="&#xE711;" Foreground="White" />
                </Button>
                <TextBlock x:Name="PreviewInfo" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="12" Foreground="White" Style="{StaticResource CaptionTextBlockStyle}" />
            </Grid>
        </Grid>
    </Grid>
</Window>
