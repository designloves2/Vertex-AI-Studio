<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="ImageStudio.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <!-- Highlight (accent) = white with black text, instead of the Windows accent colour. -->
                    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#E6FFFFFF" />
                    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#CCFFFFFF" />
                    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#000000" />
                    <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#B3000000" />
                    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#E6FFFFFF" />
                    <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#CCFFFFFF" />
                    <SolidColorBrush x:Key="PaneBrush" Color="#14FFFFFF" />
                    <SolidColorBrush x:Key="UserBubbleBrush" Color="#0078D4" />
                    <SolidColorBrush x:Key="AccentText" Color="#4CC2FF" />
                    <SolidColorBrush x:Key="WarnText" Color="#F5C04A" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="PaneBrush" Color="#0A000000" />
                    <SolidColorBrush x:Key="UserBubbleBrush" Color="#0067C0" />
                    <SolidColorBrush x:Key="AccentText" Color="#005FB8" />
                    <SolidColorBrush x:Key="WarnText" Color="#9D5D00" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- Highlight colour: white instead of the Windows accent (text on it is black in dark theme). -->
            <Color x:Key="SystemAccentColor">#FFFFFFFF</Color>
            <Color x:Key="SystemAccentColorLight1">#FFFFFFFF</Color>
            <Color x:Key="SystemAccentColorLight2">#FFFFFFFF</Color>
            <Color x:Key="SystemAccentColorLight3">#FFFFFFFF</Color>
            <Color x:Key="SystemAccentColorDark1">#FFE6E6E6</Color>
            <Color x:Key="SystemAccentColorDark2">#FFD0D0D0</Color>
            <Color x:Key="SystemAccentColorDark3">#FFBBBBBB</Color>


            <Style x:Key="PanelHeader" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="CharacterSpacing" Value="60" />
                <Setter Property="Margin" Value="0,18,0,6" />
            </Style>
            <Style x:Key="RowLabel" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="SubText" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="12,6" />
            </Style>
            <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Width" Value="34" />
                <Setter Property="Height" Value="34" />
                <Setter Property="Padding" Value="0" />
            </Style>
            <Style x:Key="ChipBorder" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="Padding" Value="10,3" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
